# Database connection

DATABASE_URL="database://user:password@localhost:port/dbname"

# AWS S3 configuration

S3_ACCESS_KEY_ID=key_id_here
S3_SECRET_KEY=secret_key_here
S3_URL="url_here"
S3_REGION=region_here
S3_BUCKET=bucket_name_here
MAX_STORAGE=10737418240 # 10 GB in bytes

# Environment configuration

ENVIRONMENT="development"
PORT=port_number_here

# JWT configuration

JWT_SECRET="your_jwt_secret_key"
JWT_ACCESS_TOKEN_EXPIRATION="15m"
JWT_REFRESH_TOKEN_EXPIRATION="7d"
JWT_ACCESS_TOKEN_MAX_AGE=900000 # 15 minutes in ms
JWT_REFRESH_TOKEN_MAX_AGE=604800000 # 7 days in ms


# Resend Email sender

RESEND_API_KEY=your_api_key_here
