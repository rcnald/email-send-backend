{
  "name": "email-send",
  "packageManager": "yarn@4.7.0",
  "scripts": {
    "dev": "nodemon -q --watch src --watch docs --ext ts,json --exec tsx src/infra/server.ts",
    "build": "tsc --project tsconfig.build.json && tsc-alias -p tsconfig.build.json && prisma generate --no-hints",
    "build:docs": "scalar export -i ./docs/swagger.json -o ./public",
    "start": "node dist/infra/server.js",
    "test": "vitest run",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "swagger": "node scripts/swagger.js",
    "setup": "docker compose up -d && sleep 2 && prisma migrate deploy && prisma generate",
    "check": "ultracite check",
    "fix": "ultracite fix"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.12",
    "@faker-js/faker": "^9.9.0",
    "@scalar/cli": "^1.2.9",
    "@swc/core": "^1.12.5",
    "@types/bcrypt": "^6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5",
    "@types/jsonwebtoken": "^9",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.15.30",
    "@types/supertest": "^6.0.3",
    "dotenv": "^17.2.0",
    "globals": "^16.2.0",
    "nodemon": "^3.1.10",
    "prisma": "6.11.1",
    "supertest": "^7.1.3",
    "ts-node": "^10.9.2",
    "tsc": "^2.0.4",
    "tsc-alias": "^1.8.16",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "ultracite": "7.1.1",
    "unplugin-swc": "^1.5.4",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.3"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.848.0",
    "@aws-sdk/s3-request-presigner": "^3.848.0",
    "@prisma/client": "6.11.1",
    "@scalar/express-api-reference": "^0.8.13",
    "@sentry/node": "^10.45.0",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dayjs": "^1.11.13",
    "express": "^5.1.0",
    "express-rate-limit": "^8.3.1",
    "install": "^0.13.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.1",
    "resend": "^4.7.0",
    "zod": "^4.0.5",
    "zod-validation-error": "^4.0.2"
  }
}
